//@version=6
indicator("SMA Crossover Test", overlay=true)
fastLen = input.int(20, "Fast Length", minval=1)
slowLen = input.int(50, "Slow Length", minval=1)
fastMA = ta.sma(close, fastLen)
slowMA = ta.sma(close, slowLen)
plot(fastMA, "Fast SMA", color=color.blue)
plot(slowMA, "Slow SMA", color=color.orange)
bullCross = ta.crossover(fastMA, slowMA)
bearCross = ta.crossunder(fastMA, slowMA)
plotshape(bullCross, title="Bull Cross", location=location.belowbar, style=shape.triangleup, color=color.green, size=size.tiny)
plotshape(bearCross, title="Bear Cross", location=location.abovebar, style=shape.triangledown, color=color.red, size=size.tiny)
