//@version=6
indicator("Market Session Boxes", overlay=true)

sessionStart = "0930-1600"
inSession = not na(time(timeframe.period, sessionStart))
newSession = inSession and not inSession[1]
endSession = not inSession and inSession[1]

var float sessHigh = na
var float sessLow = na
var int sessStartBar = na

if newSession
    sessHigh := high
    sessLow := low
    sessStartBar := bar_index
else if inSession
    sessHigh := math.max(sessHigh, high)
    sessLow := math.min(sessLow, low)

if endSession
    box.new(sessStartBar, sessHigh, bar_index, sessLow, border_color=color.blue, bgcolor=color.new(color.blue, 90))
    label.new(sessStartBar, sessHigh, "Session", style=label.style_label_down, color=color.blue, textcolor=color.white)
